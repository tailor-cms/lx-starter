# Test Environment Variables
NODE_ENV=test
PORT=3001
LOG_LEVEL=error
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database - using in-memory SQLite for tests
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=:memory:
DATABASE_USERNAME=test
DATABASE_PASSWORD=test
DATABASE_SSL=false
DATABASE_LOGGING=false

# Auth
AUTH_SALT_ROUNDS=10
AUTH_JWT_ISSUER=test-app
AUTH_JWT_SECRET=test-jwt-secret
AUTH_JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=access_token

# OAuth
OAUTH_ACCESS_TOKEN_EXPIRES_IN=1h
OAUTH_DEFAULT_RATE_LIMIT=1000

# Garment
GARMENT_KEY=test-key
GARMENT_SECRET=test-secret
GARMENT_REGION=us-east-1
GARMENT_BUCKET=test-bucket
GARMENT_ENDPOINT=
