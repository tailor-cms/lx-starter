# =============================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains all environment variables used by the NestJS backend.
# Copy this file to .env and update the values according to your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL CONFIGURATION
# From: apps/backend/src/config/general.config.ts
# -----------------------------------------------------------------------------

# Server hostname - the address or the domain name where the backend server
# will run
HOSTNAME=localhost

# Server port - The port on which the backend server will run
# Default: 3000
PORT=3000

# Frontend dev server port for 'pnpm dev'
# Should match the app's serving port:
#   Local: matches PORT env variable
#   Production: typically 80 (HTTP) or 443 (HTTPS)
#   Behind proxy: matches reverse proxy port
REVERSE_PROXY_PORT=8080

# Node environment
# Valid values: development, production, test, staging
# Default: development
NODE_ENV=development

# Pino log level
# Valid values: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# CORS allowed origins - comma-separated list of allowed origins
# Multiple origins example: http://localhost:3000,https://app.example.com
# Default: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Skip content analysis on startup
# Useful for CI/testing environments where analysis is not needed
# Accepts: true, false
# Default: false
SKIP_CONTENT_ANALYSIS=false

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# From: apps/backend/src/config/db.config.ts
# -----------------------------------------------------------------------------

# PostgreSQL host address
# Default: localhost
DATABASE_HOST=localhost

# PostgreSQL port
# Default: 5432
DATABASE_PORT=5432

# Database name
# Default: lx
DATABASE_NAME=lx

# Database username
# Default: dev
DATABASE_USERNAME=dev

# Database password
# Default: dev
DATABASE_PASSWORD=dev

# Enable SSL for database connection
# Accepts: true, false, yes, no, 1, 0
# Default: false
DATABASE_SSL=false

# Enable database query logging
# Useful for debugging but can be verbose in production
# Accepts: true, false, yes, no, 1, 0
# Default: false
DATABASE_LOGGING=false

# Run database migrations automatically on application startup
# Accepts: true, false, yes, no, 1, 0
# Default: false
DATABASE_AUTO_MIGRATIONS=false

# Shared database default name (for multi-tenant PostgreSQL instances)
# When set, the init-db script will connect to this database first
# to create the DATABASE_NAME database if it doesn't exist.
# Leave empty for dedicated database instances.
# Default: empty
# DATABASE_SHARED_DEFAULT_DB_NAME=

# -----------------------------------------------------------------------------
# AUTHENTICATION CONFIGURATION
# From: apps/backend/src/config/auth.config.ts
# -----------------------------------------------------------------------------

# Bcrypt salt rounds for password hashing
# Higher values are more secure but slower (10-12 recommended for production)
# Default: 10
AUTH_SALT_ROUNDS=10

# JWT issuer - identifies who issued the token
# Default: App
AUTH_JWT_ISSUER=App

# JWT secret key - MUST be changed in production
# Used to sign and verify JWT tokens
# Default: auth-jwt-secret
AUTH_JWT_SECRET=auth-jwt-secret

# JWT token expiration time
# Uses ms library format: 7d, 24h, 2h, 1m, etc.
# Default: 7d
AUTH_JWT_EXPIRES_IN=7d

# Name of the authentication cookie
# Default: access_token
AUTH_COOKIE_NAME=access_token

# -----------------------------------------------------------------------------
# OAUTH CLIENT CREDENTIALS CONFIGURATION
# From: apps/backend/src/config/oauth-client.config.ts
# -----------------------------------------------------------------------------
# OAuth 2.0 Client Credentials Flow for machine-to-machine authentication.
# Used by integrations and third-party applications to access the API.

# OAuth access token expiration time
# Format: number + unit (s|m|h|d|w) or milliseconds
# Recommended: 1h-24h for security, longer for convenience
# Default: 1h
OAUTH_ACCESS_TOKEN_EXPIRES_IN=1h

# Default rate limit per OAuth client (requests per hour)
# Default: 1000
OAUTH_DEFAULT_RATE_LIMIT=1000

# -----------------------------------------------------------------------------
# GOOGLE OAUTH CONFIGURATION
# From: apps/backend/src/config/oauth-google.config.ts
# -----------------------------------------------------------------------------

# Enable Google OAuth SSO
# Accepts: true, false, yes, no, 1, 0
# Default: false
GOOGLE_OAUTH_ENABLED=false

# Google OAuth Client ID
# Get this from Google Cloud Console > APIs & Services > Credentials
# Default: empty
GOOGLE_CLIENT_ID=

# Google OAuth Client Secret
# Get this from Google Cloud Console > APIs & Services > Credentials
# Default: empty
GOOGLE_CLIENT_SECRET=

# Google OAuth Callback URL
# Must match the authorized redirect URI in Google Cloud Console
# Development: http://localhost:3000/api/oidc/callback
# Production: https://your-domain.com/api/oidc/callback
# Default: http://localhost:3000/api/oidc/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/oidc/callback

# Google OAuth Allowed Email Domains (comma-separated)
# If specified, only users from these domains can sign in via Google OAuth
# New users from whitelisted domains will be automatically created
# Leave empty to allow all domains
# Example: example.com,mycompany.com
# Default: empty (all domains allowed)
GOOGLE_ALLOWED_DOMAINS=

# -----------------------------------------------------------------------------
# FRONTEND OIDC CONFIGURATION
# These values are injected into the frontend via cookie
# -----------------------------------------------------------------------------

# Enable OIDC login button in frontend
# Accepts: true, false, yes, no, 1, 0
# Default: false
NUXT_PUBLIC_OIDC_ENABLED=false

# Text to display on OIDC login button
# Default: Sign in with Google
NUXT_PUBLIC_OIDC_LOGIN_TEXT=Sign in with Google

# Enable OIDC logout (redirect to Google logout)
# Accepts: true, false, yes, no, 1, 0
# Default: false
NUXT_PUBLIC_OIDC_LOGOUT_ENABLED=false

# -----------------------------------------------------------------------------
# MAIL CONFIGURATION
# From: apps/backend/src/config/mail.config.ts
# -----------------------------------------------------------------------------

# SMTP server host
# Default: email-smtp.us-east-1.amazonaws.com
MAIL_HOST=email-smtp.us-east-1.amazonaws.com

# SMTP server port
# Common ports: 25 (unencrypted), 587 (TLS), 465 (SSL)
# Default: null (will use provider's default)
MAIL_PORT=587

# SMTP authentication username
# Leave empty if authentication is not required
# Default: empty
MAIL_USER=

# SMTP authentication password
# Leave empty if authentication is not required
# Default: empty
MAIL_PASSWORD=

# Use SSL/TLS for SMTP connection
# Accepts: true, false, yes, no, 1, 0
# Default: false
MAIL_SECURE=false

# Default sender name
# Default: App
MAIL_FROM_NAME=App

# Default sender email address
# Default: noreply@example.com
MAIL_FROM_EMAIL=noreply@example.com

# -----------------------------------------------------------------------------
# GARMENT - FILE STORAGE CONFIGURATION
# From: apps/backend/src/config/garment.config.ts
# -----------------------------------------------------------------------------
# Garment (@tailor-cms/garment) is a library for handling content published by
# Tailor CMS, providing S3-compatible storage integration for content files.

# AWS Access Key ID for S3 storage
# Required for file storage operations
GARMENT_KEY=your-aws-access-key-id

# AWS Secret Access Key for S3 storage
# Required for file storage operations
GARMENT_SECRET=your-aws-secret-access-key

# AWS Region where the S3 bucket is located
# Default: us-east-1
GARMENT_REGION=us-east-1

# S3 bucket name for storing content files
# Required for file storage operations
GARMENT_BUCKET=your-bucket-name

# Custom S3 endpoint (for S3-compatible services)
# Examples: MinIO, DigitalOcean Spaces, LocalStack
# Leave empty for standard AWS S3
# When set, enables path-style access (e.g., http://localhost:4566/bucket/key)
# Default: empty
GARMENT_ENDPOINT=

# -----------------------------------------------------------------------------
# AI PROVIDER CONFIGURATION
# From: apps/backend/src/config/ai.config.ts
# -----------------------------------------------------------------------------
# AI provider configuration for content analysis and recommendations.
# Uses OpenAI's GPT models for semantic content analysis

# OpenAI API Key
# Get your API key from https://platform.openai.com/api-keys
# Required for AI-powered features
AI_SECRET_KEY=your-openai-api-key

# OpenAI Model
# Default: gpt-5.1
# Other options: gpt-4o, gpt-4-turbo, etc.
AI_MODEL=gpt-5.1

# Custom OpenAI API Base URL (optional)
# Use for OpenAI-compatible services or proxies
# Leave empty for standard OpenAI endpoint
# Default: empty
AI_BASE_URL=

# -----------------------------------------------------------------------------
# CACHE CONFIGURATION
# From: apps/backend/src/config/cache.config.ts
# -----------------------------------------------------------------------------
# 4-tier caching system for high-performance content delivery:
# - Catalog: Repository list (8h)
# - Repository: Structure without content (8h)
# - Content Graph: Node metadata for lookups (8h)
# - Activity: Full content with signed URLs (8h)

# Cache store type
# Valid values: memory, redis
# memory: In-memory cache (default, no Redis required, suitable for development)
# redis: Redis cache (recommended for production, requires Redis server)
# Default: memory
CACHE_STORE=memory

# Default cache TTL (Time To Live) in seconds
# Applied to all cached items unless overridden by specific layer TTLs
# Default: 28800 (8 hours)
CACHE_DEFAULT_TTL=28800

# Catalog cache TTL in seconds
# Repository list cache (tier 1)
# Default: 28800 (8 hours)
CACHE_CATALOG_TTL=28800

# Content graph cache TTL in seconds
# Node metadata for path resolution (tier 3)
# Default: 28800 (8 hours)
CACHE_GRAPH_TTL=28800

# Repository cache TTL in seconds
# Repository structure without content (tier 2)
# Default: 28800 (8 hours)
CACHE_REPO_TTL=28800

# Activity cache TTL in seconds
# Fully loaded activities with content element hooks and signed URLs (tier 4)
# Default: 28800 (8 hours)
CACHE_ACTIVITY_TTL=28800

# Signature metadata cache TTL in seconds
# Tracks S3 signed URL expiration and freshness status
# Default: 43200 (12 hours)
CACHE_SIGNATURE_TTL=43200

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (Optional - only needed when CACHE_STORE=redis)
# -----------------------------------------------------------------------------
# Redis provides persistent cache and shared cache across multiple instances
# For development, use CACHE_STORE=memory (no Redis required)

# Redis server host
# Default: localhost
REDIS_HOST=localhost

# Redis server port
# Default: 6379
REDIS_PORT=6379

# Redis password (if authentication is enabled)
# Leave empty if Redis has no password
# Default: empty
REDIS_PASSWORD=

# Redis key namespace prefix
# Used to avoid key conflicts in shared Redis instances
# Default: lx
REDIS_NAMESPACE=lx

# -----------------------------------------------------------------------------
# CONTENT ELEMENTS CONFIGURATION (TCE_* prefix)
# -----------------------------------------------------------------------------
# Content element packages are registered statically in:
# apps/backend/src/modules/content/services/content-element-hook-registry.service.ts
#
# TCE_ environment variables are automatically transformed to camelCase and
# injected into content element hooks via the services.config object.
#
# Convention: TCE_{KEY} → config.{camelCaseKey}
# Example: TCE_MUX_VIDEO_TOKEN_ID → config.muxVideoTokenId

# MUX Video element configuration
# Required for signed playback URLs and webhook verification
TCE_MUX_TOKEN_ID=
TCE_MUX_TOKEN_SECRET=
TCE_MUX_JWT_SIGNING_KEY=
TCE_MUX_JWT_PRIVATE_KEY=

# Sentry DSN for error tracking and performance monitoring
# Get your DSN from https://sentry.io/settings/projects/your-project/keys/
# Leave empty to disable Sentry
# SENTRY_DSN=https://your-dsn-here@o1234567.ingest.sentry.io/1234567

# -----------------------------------------------------------------------------
# STATSIG - Real User Monitoring & Analytics
# https://statsig.com
# -----------------------------------------------------------------------------

# Statsig client key (public, injected into frontend via config cookie)
# Enables real user monitoring: session replay, auto-capture (clicks, page views)
NUXT_PUBLIC_STATSIG_CLIENT_KEY=
